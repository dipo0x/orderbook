# All optional. Defaults are shown.
PORT=3000

# Where each network's JSON-RPC calls are forwarded. Put a provider URL (with its API key) here:
# the key stays on the server and never ships inside the app.
# RPC_URL_MAINNET=https://api.mainnet-beta.solana.com
# RPC_URL_DEVNET=https://api.devnet.solana.com
# RPC_URL_TESTNET=https://api.testnet.solana.com

DB_PATH=./data/api.db
FLAGGED_FILE=./data/flagged-addresses.json

# Notifications
# EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
WATCH_INTERVAL_MS=15000
LARGE_TRANSFER_SOL=10
PRICE_ALERT_PERCENT=5

# Set to 1 only when running behind your own reverse proxy, so rate limits use the real client IP.
# TRUST_PROXY=1
