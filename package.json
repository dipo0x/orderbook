{
  "name": "orderbook-monorepo",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "mobile": "npm run start -w @orderbook/mobile",
    "api": "npm run dev -w @orderbook/api",
