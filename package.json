{
  "name": "orderbook-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start -w @orderbook/mobile",
    "api": "npm run dev -w @orderbook/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "version": "1.0.0",
  "dependencies": {
    "expo": "~58.0.14",
    "react": "19.3.0",
    "react-native": "0.88.0"
  }
}
